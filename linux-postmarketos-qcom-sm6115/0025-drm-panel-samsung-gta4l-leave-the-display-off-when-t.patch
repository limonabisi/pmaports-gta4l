From 925da9cf3dc0ad265df6afcf2f14b11f99ca3b6b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 21:32:21 +0300
Subject: [PATCH] drm/panel: samsung-gta4l: leave the display off when the
 panel is unknown

Do not fall back to the lide-hsd tables when the bootloader names no
panel or one the driver does not know: another panel's command tables
can leave the panel in a bad state. Fail the probe instead, so only the
serial console comes up; panel= can still name the panel by hand.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 drivers/gpu/drm/panel/panel-samsung-gta4l.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-gta4l.c b/drivers/gpu/drm/panel/panel-samsung-gta4l.c
index 34a6de6c6..29eb70ca3 100644
--- a/drivers/gpu/drm/panel/panel-samsung-gta4l.c
+++ b/drivers/gpu/drm/panel/panel-samsung-gta4l.c
@@ -35,8 +35,6 @@ struct gta4l_panel {
 
 #include "gta4l-panels.h"
 
-#define GTA4L_DEFAULT_PANEL "nt36523_lide_hsd_video"
-
 static char *panel_name;
 module_param_named(panel, panel_name, charp, 0444);
 MODULE_PARM_DESC(panel, "Panel name, overriding the one named by the bootloader");
@@ -92,8 +90,13 @@ static const struct gta4l_panel *gta4l_detect(struct device *dev)
 		}
 	}
 
-	dev_warn(dev, "falling back to %s\n", GTA4L_DEFAULT_PANEL);
-	return gta4l_find(GTA4L_DEFAULT_PANEL, strlen(GTA4L_DEFAULT_PANEL));
+	/*
+	 * Driving a panel with another panel's commands can leave it in a bad
+	 * state, so do not guess: leave the display off. The serial console
+	 * still works, and panel= can name the panel by hand.
+	 */
+	dev_err(dev, "no known panel, leaving the display off (use panel=<name>)\n");
+	return NULL;
 }
 
