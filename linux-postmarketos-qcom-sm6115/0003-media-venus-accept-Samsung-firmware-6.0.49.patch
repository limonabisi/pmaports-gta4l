From 0825070b6b93e8295cd52e9c1b43d58949b034eb Mon Sep 17 00:00:00 2001
From: limonabisi <herkesanlamaz46@gmail.com>
Date: Thu, 15 Oct 2026 08:41:54 +0300
Subject: [PATCH 03/10] media: venus: accept Samsung firmware 6.0.49

The Galaxy Tab A7 (gta4l) ships Venus firmware 6.0.49, which works with
the driver once the vcodec0 GDSC is in hardware mode. Like old IRIS2
firmware, it raises an exception on the dummy address of the end of
stream buffer, so send it a NULL one.
---
 drivers/media/platform/qcom/venus/core.c | 2 +-
 drivers/media/platform/qcom/venus/vdec.c | 5 ++++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.c b/drivers/media/platform/qcom/venus/core.c
index 243e342b0..ed818e349 100644
--- a/drivers/media/platform/qcom/venus/core.c
+++ b/drivers/media/platform/qcom/venus/core.c
@@ -1135,7 +1135,7 @@ static const struct bw_tbl qcm2290_bw_table_enc[] = {
 };
 
 static const struct firmware_version min_fw = {
-	.major = 6, .minor = 0, .rev = 55,
+	.major = 6, .minor = 0, .rev = 49,
 };
 
 static const struct venus_resources qcm2290_res = {
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 6a43ea191..a1d851ece 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -572,9 +572,12 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 		/* Send NULL EOS addr for only IRIS2 (SM8250),for firmware <= 1.0.87.
 		 * SC7280 also reports "1.0.<hash>" parsed as 1.0.0; restricting to IRIS2
 		 * avoids misapplying this quirk and breaking VP9 decode on SC7280.
+		 * AR50_LITE firmware up to 6.0.49 (Samsung Galaxy Tab A7) raises
+		 * an exception on the dummy address as well.
 		 */
 
-		if (IS_IRIS2(inst->core) && is_fw_rev_or_older(inst->core, 1, 0, 87))
+		if ((IS_IRIS2(inst->core) && is_fw_rev_or_older(inst->core, 1, 0, 87)) ||
+		    (IS_AR50_LITE(inst->core) && is_fw_rev_or_older(inst->core, 6, 0, 49)))
 			fdata.device_addr = 0;
 		else
 			fdata.device_addr = 0xdeadb000;
