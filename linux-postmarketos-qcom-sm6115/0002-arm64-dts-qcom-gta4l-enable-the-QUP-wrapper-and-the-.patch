From 00206bf779b6dedbd8f5a029f7b5cdc956e238a8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 00:15:11 +0300
Subject: [PATCH 02/24] arm64: dts: qcom: gta4l: enable the QUP wrapper and the
 debug UART console

The QUP wrapper was left disabled, so none of the serial engines below
it (debug UART, Bluetooth UART) were ever probed. Enable it and let
uart4 use the debug-uart compatible so it can be a kernel console
(ttyMSM0, 115200n8). Needs CONFIG_SERIAL_QCOM_GENI(_CONSOLE)=y.
Compile-tested only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index a4748ad7f..be732e357 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -228,6 +228,10 @@ &pon_resin {
 	status = "okay";
 };
 
+&qupv3_id_0 {
+	status = "okay";
+};
+
 &remoteproc_adsp {
 	firmware-name = "qcom/sm6115/Samsung/gta4l/adsp.mbn";
 	status = "okay";
@@ -452,8 +456,8 @@ bluetooth {
 	};
 };
 
+/* Debug UART (ttyMSM0, 115200n8), the same port the bootloader logs to */
 &uart4 {
-	compatible = "qcom,geni-uart";
 	status = "okay";
 };
 
