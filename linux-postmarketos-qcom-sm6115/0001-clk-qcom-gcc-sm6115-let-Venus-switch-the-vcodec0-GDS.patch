From 98281b6a301628e7fd55e40f0878e62e9a53f782 Mon Sep 17 00:00:00 2001
From: limonabisi <herkesanlamaz46@gmail.com>
Date: Thu, 15 Oct 2026 08:41:54 +0300
Subject: [PATCH 01/10] clk: qcom: gcc-sm6115: let Venus switch the vcodec0
 GDSC to hardware mode

Venus on SM6115 hands the vcodec0 GDSC over to the hardware once the
firmware is up. Without HW_CTRL_TRIGGER the decoder hangs on the first
frame.
---
 drivers/clk/qcom/gcc-sm6115.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/clk/qcom/gcc-sm6115.c b/drivers/clk/qcom/gcc-sm6115.c
index 4c3804701..c5251aff9 100644
--- a/drivers/clk/qcom/gcc-sm6115.c
+++ b/drivers/clk/qcom/gcc-sm6115.c
@@ -3218,6 +3218,7 @@ static struct gdsc gcc_vcodec0_gdsc = {
 	.pd = {
 		.name = "gcc_vcodec0",
 	},
+	.flags = HW_CTRL_TRIGGER,
 	.pwrsts = PWRSTS_OFF_ON,
 };
 
