From 7b9d535528f8651ce44fdefd134124cfaad4cb0e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 00:32:38 +0300
Subject: [PATCH 03/24] arm64: dts: qcom: gta4l: describe the WCN3988 Bluetooth
 correctly

The stock firmware ships apbtfw11.tlv/apnv11.bin, i.e. the chip is a
WCN3988, not a WCN3990. Fix the compatible, wire the supplies the way
the stock device tree does (xo = L16, rf = L17, ch0 = L23), add the
SW_CTRL GPIO and the four-wire UART pin states with a wake-up
interrupt on RX. Compile-tested only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 .../boot/dts/qcom/sm6115-samsung-gta4l.dts    | 84 ++++++++++++++++++-
 1 file changed, 80 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index be732e357..67dcd2c5c 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -427,6 +427,72 @@ &sdhc_2 {
 &tlmm {
 	gpio-reserved-ranges = <0 4>, <14 4>;
 
+	uart3_default: uart3-default-state {
+		cts-pins {
+			pins = "gpio8";
+			function = "qup3";
+			drive-strength = <2>;
+			bias-bus-hold;
+		};
+
+		rts-pins {
+			pins = "gpio9";
+			function = "qup3";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		tx-pins {
+			pins = "gpio10";
+			function = "qup3";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rx-pins {
+			pins = "gpio11";
+			function = "qup3";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	uart3_sleep: uart3-sleep-state {
+		cts-pins {
+			pins = "gpio8";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-bus-hold;
+		};
+
+		rts-pins {
+			pins = "gpio9";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		tx-pins {
+			pins = "gpio10";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		rx-pins {
+			pins = "gpio11";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	bt_sw_ctrl: bt-sw-ctrl-state {
+		pins = "gpio87";
+		function = "gpio";
+		bias-pull-down;
+	};
+
 	ts_rst_n: ts-rst-n-state {
 		pins = "gpio74";
 		function = "gpio";
@@ -443,15 +509,25 @@ ts_int_n: ts-int-n-state {
 };
 
 &uart3 {
+	interrupts-extended = <&intc GIC_SPI 330 IRQ_TYPE_LEVEL_HIGH>,
+			      <&tlmm 11 IRQ_TYPE_EDGE_FALLING>;
+	pinctrl-0 = <&uart3_default>;
+	pinctrl-1 = <&uart3_sleep>;
+	pinctrl-names = "default", "sleep";
 	status = "okay";
 
+	/* WCN3988: the stock firmware loads apbtfw11.tlv / apnv11.bin */
 	bluetooth {
-		compatible = "qcom,wcn3990-bt";
+		compatible = "qcom,wcn3988-bt";
+
+		pinctrl-0 = <&bt_sw_ctrl>;
+		pinctrl-names = "default";
 
 		vddio-supply = <&pm6125_l9a>;
-		vddxo-supply = <&pm6125_l18a>;
-		vddrf-supply = <&pm6125_l23a>;
-		vddch0-supply = <&pm6125_l17a>;
+		vddxo-supply = <&pm6125_l16a>;
+		vddrf-supply = <&pm6125_l17a>;
+		vddch0-supply = <&pm6125_l23a>;
+		swctrl-gpios = <&tlmm 87 GPIO_ACTIVE_HIGH>;
 		max-speed = <3200000>;
 	};
 };
