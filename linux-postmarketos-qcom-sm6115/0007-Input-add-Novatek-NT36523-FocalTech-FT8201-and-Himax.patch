From 1c3f618e810ad893e6e5527e0cb8f1349d9be09c Mon Sep 17 00:00:00 2001
From: limonabisi <herkesanlamaz46@gmail.com>
Date: Thu, 15 Oct 2026 08:41:55 +0300
Subject: [PATCH 07/10] Input: add Novatek NT36523, FocalTech FT8201 and Himax
 HX83102E SPI touchscreen drivers

Touch parts of the TDDI panels found in the Galaxy Tab A7 (gta4l). They
load the controller firmware of the fitted panel and follow the DRM
panel's power state.
---
 drivers/input/touchscreen/Kconfig             |   49 +
 drivers/input/touchscreen/Makefile            |    3 +
 .../input/touchscreen/focaltech-ft8201-spi.c  |  978 +++++++++++
 .../input/touchscreen/himax-hx83102e-spi.c    | 1442 +++++++++++++++++
 .../input/touchscreen/novatek-nt36523-spi.c   | 1228 ++++++++++++++
 5 files changed, 3700 insertions(+)
 create mode 100644 drivers/input/touchscreen/focaltech-ft8201-spi.c
 create mode 100644 drivers/input/touchscreen/himax-hx83102e-spi.c
 create mode 100644 drivers/input/touchscreen/novatek-nt36523-spi.c

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8ac3..56db79989 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -701,6 +701,55 @@ config TOUCHSCREEN_NOVATEK_NVT_TS
 	  To compile this driver as a module, choose M here: the
 	  module will be called novatek-nvt-ts.
 
+config TOUCHSCREEN_NOVATEK_NT36523_SPI
+	tristate "Novatek NT36523 SPI touchscreen support"
+	depends on SPI_MASTER
+	depends on DRM || !DRM
+	select FW_LOADER
+	help
+	  Say Y here if you have a Novatek NT36523 touch and display
+	  driver integration (TDDI) panel whose touch part is connected
+	  over SPI, as found in the Samsung Galaxy Tab A7 10.4 (2020).
+
+	  The controller needs a firmware image that the driver loads
+	  each time the panel is powered on.
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called novatek-nt36523-spi.
+
+config TOUCHSCREEN_FOCALTECH_FT8201_SPI
+	tristate "FocalTech FT8201 SPI touchscreen support"
+	depends on SPI_MASTER
+	depends on DRM || !DRM
+	select CRC_CCITT
+	select FW_LOADER
+	help
+	  Say Y here if you have a FocalTech FT8201 touch and display
+	  driver integration (TDDI) panel whose touch part is connected
+	  over SPI, as found in some Samsung Galaxy Tab A7 10.4 (2020).
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called focaltech-ft8201-spi.
+
+config TOUCHSCREEN_HIMAX_HX83102E_SPI
+	tristate "Himax HX83102E SPI touchscreen support"
+	depends on SPI_MASTER
+	depends on DRM || !DRM
+	select FW_LOADER
+	help
+	  Say Y here if you have a Himax HX83102E touch and display
+	  driver integration (TDDI) panel whose touch part is connected
+	  over SPI, as found in some Samsung Galaxy Tab A7 10.4 (2020).
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called himax-hx83102e-spi.
+
 config TOUCHSCREEN_IMAGIS
 	tristate "Imagis touchscreen support"
 	depends on I2C
