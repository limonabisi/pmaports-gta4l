+void convert_data_to_bytes(uint32_t val, uint8_t *buf)
+{
+	buf[0] = (val >> 8) & 0xFF;
+	buf[1] = (val) & 0xFF;
+	buf[2] = (val >> 24) & 0xFF;
+	buf[3] = (val >> 16) & 0xFF;
+}
