+/* No reset or interrupt lines are wired on the boards supported so far */
+#define gpio_is_valid(gpio)		(false)
+#define gpio_to_irq(gpio)		(-EINVAL)
+#define gpio_set_value_cansleep(gpio, v)	do { } while (0)
+#define gpio_set_value(gpio, v)		do { } while (0)
+#define devm_gpio_free(dev, gpio)	do { } while (0)
+
+static DEFINE_MUTEX(g_fsm_mutex);
+static struct device *g_fsm_pdev = NULL;
+
+/* customize configrature */
