+int zero_bit_counter(uint8_t byte)
+{
+	int count = 0;
+
+	byte = ~byte;
+	while(byte) {
+		byte &= byte - 1;
+		++count;
+	}
+	return count;
+}
+
+int get_otp_counter(uint16_t byte)
+{
+	// OTP offset start from 0x10 to 0x20(Totally 16)
+	if (byte == OTP_OP_COUNTER_OFFSET) {
+		return 0;
+	}
+	return (LOW8(byte) - LOW8(OTP_OP_COUNTER_OFFSET) + 1);
+}
