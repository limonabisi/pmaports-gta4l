 &gpi_dma0 {
@@ -642,6 +675,75 @@ &xo_board {
 	clock-frequency = <19200000>;
 };
 
+/* Four FourSemi FS18xx amplifiers share the primary MI2S data line */
+&i2c1 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	speaker_amp: amplifier@36 {
+		compatible = "foursemi,fs18xx";
+		reg = <0x36>;
+		fsm,position = "LBTM";
+		#sound-dai-cells = <0>;
+	};
+
+	amplifier@35 {
+		compatible = "foursemi,fs18xx";
+		reg = <0x35>;
+		fsm,position = "LTOP";
+	};
+
+	amplifier@34 {
+		compatible = "foursemi,fs18xx";
+		reg = <0x34>;
+		fsm,position = "RTOP";
+	};
+
+	amplifier@37 {
+		compatible = "foursemi,fs18xx";
+		reg = <0x37>;
+		fsm,position = "RBTM";
+	};
+};
+
+&lpass_tlmm {
+	/* The vendor firmware wants the core vote held before the audio one */
+	clocks = <&q6afecc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+		 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	clock-names = "core", "audio";
+
+	lpi_i2s1_active: lpi-i2s1-active-state {
+		sck-pins {
+			pins = "gpio6";
+			function = "i2s1_clk";
+			bias-disable;
+			drive-strength = <8>;
+		};
+
+		ws-pins {
+			pins = "gpio7";
+			function = "i2s1_ws";
+			bias-disable;
+			drive-strength = <8>;
+		};
+
+		data-pins {
+			pins = "gpio8";
+			function = "i2s1_data";
+			bias-disable;
+			drive-strength = <8>;
+		};
+	};
+};
+
+&q6afedai {
+	dai@16 {
+		reg = <PRIMARY_MI2S_RX>;
+		qcom,sd-lines = <0>;
+	};
+};
+
 &venus {
 	firmware-name = "qcom/sm6115/Samsung/gta4l/venus.mbn";
 
