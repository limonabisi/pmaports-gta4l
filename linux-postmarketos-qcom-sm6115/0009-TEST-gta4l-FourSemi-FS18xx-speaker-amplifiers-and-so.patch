+int fsm_stub_post_calib(fsm_dev_t *fsm_dev)
+{
+	fsm_config_t *cfg = fsm_get_config();
+	uint8_t valOTP;
+	uint16_t cal_zm;
+	int ret;
+
+	if (fsm_dev == NULL || !cfg || !fsm_dev->tdata) {
+		return -EINVAL;
+	}
+	if (!fsm_dev->state.re25_runin) {
+		pr_addr(info, "invalid running state");
+		return 0;
+	}
+	if (fsm_dev->dev_ops.post_calib) {
