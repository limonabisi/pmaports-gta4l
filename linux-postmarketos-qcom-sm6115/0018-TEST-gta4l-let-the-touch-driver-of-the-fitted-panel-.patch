From 96cb4cb31c5415a12280a30a0251e58ea3cd26b5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 16:29:54 +0300
Subject: [PATCH 18/24] TEST: gta4l: let the touch driver of the fitted panel
 family bind

List the Himax and FocalTech controllers next to the Novatek one, and
make the Novatek driver step aside when the bootloader names a panel of
another family.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 .../boot/dts/qcom/sm6115-samsung-gta4l.dts    |  8 ++++++-
 .../input/touchscreen/novatek-nt36523-spi.c   | 23 +++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index 20554da46..eb84edecb 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -564,7 +564,13 @@ &spi0 {
 	status = "okay";
 
 	touchscreen@0 {
-		compatible = "novatek,nt36523-spi";
+		/*
+		 * The controller depends on the panel variant; each driver
+		 * checks the panel the bootloader names and only binds to its
+		 * own family.
+		 */
+		compatible = "novatek,nt36523-spi", "himax,hx83102e-spi",
+			     "focaltech,ft8201-spi";
 		reg = <0>;
 		spi-max-frequency = <9600000>;
 
diff --git a/drivers/input/touchscreen/novatek-nt36523-spi.c b/drivers/input/touchscreen/novatek-nt36523-spi.c
index 2e6de35f5..54eea6d7e 100644
--- a/drivers/input/touchscreen/novatek-nt36523-spi.c
+++ b/drivers/input/touchscreen/novatek-nt36523-spi.c
@@ -1061,6 +1061,26 @@ static const char *nvt_fw_name_for_panel(struct device *dev, const char *name)
 	return fw ?: name;
 }
 
+/*
+ * The touch node of these tablets is shared by the drivers of every touch
+ * controller fitted to the different panel variants. When the bootloader
+ * names a panel of another controller family, leave the device to its driver.
+ */
+static bool nvt_other_panel(void)
+{
+	static const char key[] = "dsi_display0=qcom,mdss_dsi_";
+	const char *args, *s;
+
+	if (!of_chosen || of_property_read_string(of_chosen, "bootargs", &args))
+		return false;
+
+	s = strstr(args, key);
+	if (!s)
+		return false;
+
+	return strncmp(s + sizeof(key) - 1, "nt36523_", 8) != 0;
+}
+
 static int nvt_probe(struct spi_device *spi)
 {
 	struct device *dev = &spi->dev;
@@ -1068,6 +1088,9 @@ static int nvt_probe(struct spi_device *spi)
 	struct nvt_ts *ts;
 	int ret;
 
+	if (nvt_other_panel())
+		return -ENODEV;
+
 	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
 	if (!ts)
 		return -ENOMEM;
