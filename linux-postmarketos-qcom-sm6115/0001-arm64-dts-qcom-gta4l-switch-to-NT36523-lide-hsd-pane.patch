From de82b98dad0e3805387a17b429eb7e341a92b2ae Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 5 Oct 2026 19:30:57 +0300
Subject: [PATCH 01/24] arm64: dts: qcom: gta4l: switch to NT36523 lide-hsd
 panel and Novatek touch node

Add the Samsung gta4l NT36523 "lide hsd" panel to the Novatek NT36523
panel driver, with the init sequence taken from the stock device tree
node qcom,mdss_dsi_nt36523_lide_hsd_video, and point the board device
tree at it. Rename the dummy touchscreen node the bootloader checks for
from himax_ts@0 to novatek@0.

Compile-tested only; not yet run on hardware.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 .../boot/dts/qcom/sm6115-samsung-gta4l.dts    |  31 +-
 drivers/gpu/drm/panel/panel-novatek-nt36523.c | 457 ++++++++++++++++++
 2 files changed, 483 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index 4e6bb7045..a4748ad7f 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -45,6 +45,24 @@ framebuffer0: framebuffer@5c000000 {
 		};
 	};
 
+	/*
+	 * Panel power: 1.8 V I/O rail (L9A) plus the stock
+	 * qcom,platform-vcc-gpio (tlmm 71). Kept always on so that the
+	 * rails the bootloader left enabled are never dropped under the
+	 * panel while LAB/IBB (not controlled by this kernel) stay up.
+	 */
+	panel_vcc: regulator-panel-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vcc";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 71 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm6125_l9a>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -124,11 +142,13 @@ &mdss_dsi0 {
 	status = "okay";
 
 	panel: panel@0 {
-		compatible = "innolux,hx83102e-inx-fhd";
+		/* NT36523 "lide hsd" panel variant (Novatek touch tablets) */
+		compatible = "samsung,gta4l-lide-hsd-nt36523";
 		reg = <0>;
 
-		enable-gpios = <&tlmm 71 GPIO_ACTIVE_HIGH>;
-		pp1800-supply = <&pm6125_l9a>;
+		/* stock: qcom,platform-reset-gpio = <&tlmm 81 0> */
+		reset-gpios = <&tlmm 81 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&panel_vcc>;
 
 		rotation = <270>;
 
@@ -481,8 +501,9 @@ spi@4a80000 {
 		reg = <0x0 0x04a80000 0x0 0x4000>;
 		status = "disabled";
 
-		himax_ts@0 {
-		status = "disabled";
+		/* The bootloader of Novatek touch tablets looks for this node */
+		novatek@0 {
+			status = "disabled";
 		};
 	};
 };
