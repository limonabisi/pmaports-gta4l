#!/bin/sh
# gta4l: at boot PulseAudio can look at the sound card while it is still
# being put together, give up on it and fall back to a dummy output. If no
# real output shows up after login, restart PulseAudio so it looks again.
for i in 1 2 3 4 5 6 7 8; do
	sleep 5
	pactl list short sinks 2>/dev/null | grep -q alsa_output && exit 0
	[ -e /dev/snd/controlC0 ] || continue
	pulseaudio -k 2>/dev/null
	sleep 2
	pactl info >/dev/null 2>&1 || pulseaudio --start
done
exit 0
