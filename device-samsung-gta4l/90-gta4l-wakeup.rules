# These wake the tablet a second after it falls asleep: the battery and
# charger supplies, the debug UART, the remote processors and the thermal
# sensor. The power and volume keys and the RTC keep their wake-up ability.
ACTION=="add", SUBSYSTEM=="power_supply", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"
ACTION=="bind", SUBSYSTEM=="platform", KERNEL=="4a8c000.serial", ATTR{power/wakeup}="disabled"
ACTION=="bind", SUBSYSTEM=="platform", KERNEL=="*.remoteproc", ATTR{power/wakeup}="disabled"
ACTION=="bind", SUBSYSTEM=="platform", KERNEL=="4411000.thermal-sensor", ATTR{power/wakeup}="disabled"
