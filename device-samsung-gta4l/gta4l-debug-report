#!/bin/sh
# Hardware report for debugging: prints the state of the battery, charger,
# remote processors, GPU, sound, Venus, network and touch to the kernel log
# (and so the UART) for about five minutes after boot. Not enabled by default:
#   systemctl enable gta4l-debug-report
out() { echo "gta4l-report: $*" > /dev/kmsg; }
P=/sys/class/power_supply/qcom-qg-battery
batt() { out "t=$(cut -d' ' -f1 /proc/uptime) batt $(cat $P/capacity)% $(($(cat $P/voltage_now) / 1000))mV $(($(cat $P/current_now) / 1000))mA $(cat $P/status) usbin=$(cat /sys/bus/iio/devices/iio:device*/in_voltage_usb_in_v_div_16_input 2>/dev/null)"; }

batt

out "fw-import: $(tr '\n' '|' < /var/log/gta4l-firmware-import.log 2>/dev/null | cut -c1-900)"
for r in /sys/class/remoteproc/*; do out "$(cat "$r/name") state=$(cat "$r/state")"; done
out "gpu: $(dmesg | grep -i -E 'adreno|zap|gpu hw init' | tail -3 | tr '\n' '|')"
out "input: $(grep -h Name= /proc/bus/input/devices | tr '\n' ' ')"

# Raw touch coordinates, at most one line a second, to compare with where
# the finger really is
touchlog() {
	sleep 12
	for d in /sys/class/input/event*; do
		grep -q -i novatek "$d/device/name" 2>/dev/null || continue
		e=/dev/input/${d##*/}
		out "touch: logging $e"
		x=-1; y=-1; last=0
		hexdump -v -e '12/2 "%04x " "\n"' "$e" | while read -r a b c dd f g h i ty co lo hi; do
			[ "$ty" = 0003 ] || continue
			case "$co" in 0035) x=$((0x$lo)) ;; 0036) y=$((0x$lo)) ;; *) continue ;; esac
			now=$(cut -d. -f1 /proc/uptime)
			[ "$now" -gt "$last" ] && [ "$x" -ge 0 ] && [ "$y" -ge 0 ] && { out "touch: raw x=$x y=$y (max 1199 x 1999)"; last=$now; }
		done
	done
}
touchlog &

i=0
while [ $i -lt 60 ]; do
	sleep 5
	batt
	[ $((i % 6)) -eq 5 ] && out "ip: $(ip -4 -br addr show wlan0 2>&1)"
	# Type-C state machine log, only the lines added since the last look
	for t in /sys/kernel/debug/usb/tcpm-*; do
		[ -r "$t" ] || continue
		n=$(wc -l < "$t")
		if [ "$n" != "${TCPM_N:-0}" ]; then
			dn=$((n - ${TCPM_N:-0}))
			if [ "$dn" -lt 1 ] || [ "$dn" -gt 14 ]; then dn=14; fi
			tail -n "$dn" "$t" | cut -c1-150 | while read -r l; do out "tcpm: $l"; done
			TCPM_N=$n
		fi
	done
	i=$((i + 1))
	if [ $i -eq 6 ]; then
		out "bluetooth: $(bluetoothctl list 2>&1 | tr '\n' ' ')"
		out "net: $(ip -br link 2>&1 | tr '\n' '|')"
		out "ip: $(ip -4 -br addr 2>&1 | tr '\n' '|')"
		out "gpu3: $(grep -i -E 'adreno|zap|gpu hw' /dev/kmsg 2>/dev/null | head -0)$(journalctl -k -b --no-pager 2>/dev/null | grep -i -E 'zap|gpu hw init|a610' | tail -3 | tr '\n' '|') renderer=$(cat /sys/kernel/debug/dri/*/name 2>/dev/null | tr '\n' ' ') gpu-busy=$(ls /sys/class/devfreq 2>/dev/null | tr '\n' ' ')"
		export DISPLAY=:0 XAUTHORITY=/home/user/.Xauthority
		out "xtools: $(command -v xrandr xinput 2>&1 | tr '\n' ' ')"
		out "xrandr: $(xrandr --query 2>&1 | grep -E 'Screen|connected' | tr '\n' '|' | cut -c1-400)"
		out "xinput: $(xinput list --name-only 2>&1 | tr '\n' '|' | cut -c1-300)"
		out "xmatrix: $(xinput list-props 'Novatek NT36523 Touchscreen' 2>&1 | grep -i -E 'matrix|Calibration' | tr '\n' '|' | cut -c1-400)"
		out "xfdisp: $(grep -i -E 'Rotation|Reflection|Resolution' /home/user/.config/xfce4/xfconf/xfce-perchannel-xml/displays.xml 2>&1 | tr -s ' \n' ' ' | cut -c1-400)"
		out "udevts: $(udevadm info /dev/input/by-path/*spi* 2>/dev/null | grep -i -E 'CALIB|TOUCHSCREEN|ROTAT|WL_OUTPUT' | tr '\n' '|')"
		V=/sys/firmware/devicetree/base/soc@0/video-codec@5a00000
		out "venus-dt: status=$(tr -d '\0' < $V/status 2>&1) fw=$(tr -d '\0' < $V/firmware-name 2>&1)"
		out "venus-mod: $(lsmod | grep -i -E 'venus|v4l2_mem2mem|videobuf2_dma' | tr -s ' ' | tr '\n' '|') file=$(modinfo -n venus-core 2>&1)"
		out "venus-probe: $(modprobe venus-core 2>&1) drv=$(ls /sys/bus/platform/drivers/qcom-venus/ 2>&1 | tr '\n' ' ') deferred=$(grep -i -E '5a00000|video' /sys/kernel/debug/devices_deferred 2>&1 | tr '\n' '|')"
		out "venus-fw: $(ls -la /lib/firmware/updates/qcom/sm6115/Samsung/gta4l/ 2>&1 | grep -i venus | tr -s ' ' | cut -d' ' -f5,9 | tr '\n' '|' | cut -c1-300)"
		out "venus-log: $(dmesg | grep -i -E 'venus|5a00000' | grep -v gta4l | tail -8 | tr '\n' '|' | cut -c1-900)"
		out "video: $(ls /dev/video* 2>&1 | tr '\n' ' ') $(cat /sys/class/video4linux/*/name 2>/dev/null | tr '\n' '|')"
		out "gpu-x: $(grep -h -i -E 'glamor|renderer|llvmpipe|FD6|AIGLX' /var/log/Xorg.0.log 2>/dev/null | tail -4 | tr '\n' '|' | cut -c1-500)"
		out "gpu-gl: $(glxinfo -B 2>&1 | grep -i -E 'renderer|not found' | tr '\n' '|' | cut -c1-300)"
		out "sshd: $(systemctl is-active sshd) listen=$(ss -ltn 2>&1 | grep -c ':22 ') mac=$(cat /sys/class/net/wlan0/address 2>&1)"
		out "nft-svc: $(systemctl is-active nftables 2>&1) files=$(ls /etc/nftables.d 2>&1 | tr '\n' ' ')"
		nft list ruleset 2>&1 | grep -E 'chain|dport|iifname|policy' | tr -s ' \t' ' ' | head -30 | while read -r l; do out "nft: $l"; done
		out "mem: $(grep -E 'MemAvailable|SwapTotal|SwapFree' /proc/meminfo | tr -s ' ' | tr '\n' ' ')"
		out "sleep: state=$(cat /sys/power/state 2>&1) mem_sleep=$(cat /sys/power/mem_sleep 2>&1) wakeup=$(grep -l enabled /sys/bus/platform/devices/*/power/wakeup 2>/dev/null | wc -l)"
		out "snd-cards: $(tr -s ' \n' ' ' < /proc/asound/cards 2>&1 | cut -c1-300) tools=$(command -v aplay amixer speaker-test pactl wpctl 2>&1 | tr '\n' ' ')"
		out "snd-mod: $(lsmod | grep -E 'fs18xx|sm8250|soundwire|qcom_sdw' | tr -s ' ' | tr '\n' '|') i2c=$(ls /sys/bus/i2c/devices 2>&1 | tr '\n' ' ')"
		out "snd-def: $(cat /sys/kernel/debug/devices_deferred 2>&1 | tr '\n' '|' | cut -c1-500)"
		dmesg | grep -i -E 'fs18|fsm|foursemi|q6afe|lpass|lpi|sndcard|sound|asoc|snd_soc|amplifier' | grep -v gta4l-report | tail -40 | cut -c1-260 | while read -r l; do out "snd: $l"; done
		iw reg set TR 2>/dev/null
		out "wifi-scan: nets=$(nmcli -t -f SSID,CHAN dev wifi list --rescan yes 2>&1 | wc -l) sample=$(nmcli -t -f SSID,CHAN,SIGNAL dev wifi list 2>&1 | head -6 | tr '\n' '|' | cut -c1-300) reg=$(iw reg get 2>&1 | grep -m2 country | tr '\n' ' ') iw=$(command -v iw)"
		out "lightdm: $(systemctl is-active lightdm) sessions: $(loginctl list-sessions --no-legend 2>&1 | tr '\n' '|')"
		out "gpu2: $(dmesg | grep -i -E 'adreno|zap|gpu hw init' | tail -3 | tr '\n' '|')"
	fi
done
