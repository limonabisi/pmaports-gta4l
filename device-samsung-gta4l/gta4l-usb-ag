#!/bin/sh
# gta4l: USB ag gadget'ini Windows'un taniyacagi kimlige ve high-speed'e cevirir.
# Eski kimlik 18d1:d001 (Android ADB) Windows'ta ADB surucusuyla karisiyordu,
# SuperSpeed ise PC'de "USB aygiti taninmadi" hatasi veriyordu.
G=$(ls -d /sys/kernel/config/usb_gadget/*/ 2>/dev/null | head -n1)
[ -n "$G" ] || exit 0
U=$(ls /sys/class/udc 2>/dev/null | head -n1)
[ -n "$U" ] || exit 0
cd "$G" || exit 0
echo "" > UDC 2>/dev/null
echo high-speed > max_speed
echo 0x1d6b > idVendor
echo 0x0104 > idProduct
echo "$U" > UDC
exit 0
