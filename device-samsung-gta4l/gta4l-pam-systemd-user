# Used by systemd --user instances. A copy of systemd's
# /usr/lib/pam.d/systemd-user without the pam_selinux lines: Alpine's
# linux-pam has no pam_selinux.so, and a missing required module (even
# marked "-", which only keeps it out of the log) keeps the user manager
# (user@.service) from ever starting.

account  required   pam_unix.so no_pass_expiry

auth     required   pam_rootok.so

session  required   pam_loginuid.so
session  optional   pam_keyinit.so force revoke
session  required   pam_namespace.so
session  optional   pam_umask.so silent
session  optional   pam_systemd.so
