# Maintainer: limonabisi <herkesanlamaz46@gmail.com>
# hexagonrpcd with one change gta4l's sensor firmware needs: it also asks for
# sns_reg_version next to the sensor registry. Installed under its own name so
# it does not replace the distribution's hexagonrpcd.
pkgname=hexagonrpcd-gta4l
pkgver=0.4.0_git20260915
pkgrel=1
_commit="da7a3742ab8d5273a281b70ee11f16fb2cb6a690"
pkgdesc="hexagonrpcd patched for the Samsung Galaxy Tab A7 10.4 2020 sensors"
url="https://github.com/linux-msm/hexagonrpc"
arch="aarch64"
license="GPL-3.0-or-later"
makedepends="meson linux-headers"
options="!check"
source="
	hexagonrpc-$_commit.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/$_commit.tar.gz
	0001-rpcd-serve-sns_reg_version-next-to-the-sensor-registry.patch
	"
builddir="$srcdir/hexagonrpc-$_commit"

prepare() {
	default_prepare
	# Link libhexagonrpc into the daemon: only the daemon is packaged, under
	# its own name, so it must not need the library from another package.
	sed -i -e 's/^libhexagonrpc = shared_library(/libhexagonrpc = static_library(/' \
		-e '/soversion : api_version,/d' libhexagonrpc/meson.build
}

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	install -Dm755 output/hexagonrpcd/hexagonrpcd \
		"$pkgdir"/usr/bin/hexagonrpcd-gta4l
}

# Generate with: pmbootstrap checksum hexagonrpcd-gta4l
sha512sums="
866ffde3110d3744cd6ea0dd4b965e640e293e21a77cd3767ba770515ed09dda11667d70f806d4fedad283d7e38671c2d455b6c612b7225a038930d3eac5bc2c  hexagonrpc-da7a3742ab8d5273a281b70ee11f16fb2cb6a690.tar.gz
450b482bc894bf3358a3b684ac8de327f068580c020cb0beed273b3f2e7b84351fa954b250cc9aebfba9da71f9ee95d0c7bdcb6ae23f4145131994dc25dfc262  0001-rpcd-serve-sns_reg_version-next-to-the-sensor-registry.patch
"
