# unmaintained
maintainer=""
pkgname=firmware-samsung-gta4l
pkgver=0
pkgrel=4
pkgdesc="Firmware for Samsung Galaxy Tab A7 10.4 2020"
subpackages="
	$pkgname-adreno
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-ipa
	$pkgname-radio
	$pkgname-rproc
	$pkgname-rproc-openrc:rproc_openrc
	$pkgname-speaker
	$pkgname-touch:touch_fw
	$pkgname-venus
	"
url="https://github.com/LinuxForGta4l/firmware-samsung-gta4l"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="0a801b7edb2cb69bcb4f17261bd3a25dba304857"
_vendor_commit="b3ad53486fafbcca29dbf01d60b0052bb0c060ff"
_vendor_url="https://github.com/TheMuppets/proprietary_vendor_samsung_gta4l-common/raw/$_vendor_commit/proprietary/vendor/firmware"

# Each panel variant of the tablet comes with its own touch controller and
# firmware; the drivers pick the file named after the fitted panel.
_touch_fw="
	novatek_ts_fw_hlt_auo.bin
	novatek_ts_fw_lce_panda.bin
	novatek_ts_fw_lide_hsd.bin
	novatek_ts_fw_txd_inx.bin
	focal_ts_fw_lide_hsd.bin
	focal_ts_fw_tianma_tianma.bin
	focaltech_ts_fw_lide.bin
	Himax_firmware_djn_jdi.bin
	Himax_firmware_hlt_auo.bin
	Himax_firmware_inx_fhd.bin
	Himax_firmware_lide_hsd.bin
	Himax_firmware_tianma_tianma.bin
	Himax_firmware_txd_auo.bin
	Himax_firmware_txd_auo_al.bin
	Himax_firmware_txd_inx.bin
	"
_speaker_fw="fs1801.fsm"

source="$pkgname-$_commit.tar.gz::https://github.com/LinuxForGta4l/firmware-samsung-gta4l/archive/$_commit.tar.gz"
for _f in $_touch_fw $_speaker_fw; do
	source="$source ${_f%.*}-$_vendor_commit.${_f##*.}::$_vendor_url/$_f"
done
builddir="$srcdir/$pkgname-$_commit/"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

adreno() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 adreno firmware"
	depends="firmware-qcom-adreno-a610"

	install -Dm644 "$builddir"/a610_zap.mbn -t \
		"$subpkgdir/lib/firmware/qcom/sm6115/Samsung/gta4l/"
}

adsp() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 ADSP firmware"

	install -Dm644 "$builddir"/adsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm6115/Samsung/gta4l/"
}

cdsp() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 CDSP firmware"

	install -Dm644 "$builddir"/cdsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm6115/Samsung/gta4l/"
}

ipa() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 IPA firmware"

	install -Dm644 "$builddir"/ipa_fws.mbn -t \
		"$subpkgdir/lib/firmware/qcom/sm6115/Samsung/gta4l/"
}

radio() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 radio firmware"
	depends="linux-firmware-ath10k"

	install -Dm644 "$builddir"/modem*.jsn -t \
		"$subpkgdir/lib/firmware/qcom/sm6115/Samsung/gta4l/"
	install -Dm644 "$builddir"/wlanmdsp.mbn -t \
		"$subpkgdir/lib/firmware/qcom/sm6115/Samsung/gta4l/"
}

rproc() {
	pkgdesc="Modem and Wifi services and configuration"
	depends="
		rmtfs
		tqftpserv
	"
	mkdir "$subpkgdir"
}

rproc_openrc() {
	install_if="$pkgname-rproc openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="
		openrc
		tqftpserv-openrc
	"
	mkdir "$subpkgdir"
}

speaker() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 speaker amplifier tuning"

	local f
	for f in $_speaker_fw; do
		install -Dm644 "$srcdir/${f%.*}-$_vendor_commit.${f##*.}" \
			"$subpkgdir/lib/firmware/$f"
	done
}

touch_fw() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 touchscreen firmware (all panel variants)"

	local f
	for f in $_touch_fw; do
		install -Dm644 "$srcdir/${f%.*}-$_vendor_commit.${f##*.}" \
			"$subpkgdir/lib/firmware/$f"
	done
}

venus() {
	pkgdesc="Samsung Galaxy Tab A7 10.4 2020 venus firmware"

	install -Dm644 "$builddir"/venus.mbn -t \
		"$subpkgdir/lib/firmware/qcom/sm6115/Samsung/gta4l/"
}

