From 9a028cda24121e59ce3c880a84ba3f8b30103532 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 19:24:11 +0300
Subject: [PATCH 12/24] TEST: gta4l: one panel driver for every panel variant,
 chosen from the command line

The stock device tree describes fifteen 1200x2000 panels. Replay the
vendor command tables (generated from that tree) and pick the entry the
bootloader names in msm_drm.dsi_display0=. Only the NT36523 lide-hsd
entry can be tested here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 .../boot/dts/qcom/sm6115-samsung-gta4l.dts    |    7 +-
 drivers/gpu/drm/panel/Kconfig                 |   10 +
 drivers/gpu/drm/panel/Makefile                |    1 +
 drivers/gpu/drm/panel/gta4l-panels.h          | 1979 +++++++++++++++++
 drivers/gpu/drm/panel/panel-samsung-gta4l.c   |  347 +++
 5 files changed, 2342 insertions(+), 2 deletions(-)
 create mode 100644 drivers/gpu/drm/panel/gta4l-panels.h
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-gta4l.c

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index 2ba880381..34c52bd1c 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -203,8 +203,11 @@ &mdss_dsi0 {
 	status = "okay";
 
 	panel: panel@0 {
-		/* NT36523 "lide hsd" panel variant (Novatek touch tablets) */
-		compatible = "samsung,gta4l-lide-hsd-nt36523";
+		/*
+		 * One of many 1200x2000 panels; the driver picks the one the
+		 * bootloader names on the command line.
+		 */
+		compatible = "samsung,gta4l-panel";
 		reg = <0>;
 
 		/* stock: qcom,platform-reset-gpio = <&tlmm 81 0> */
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index cbdf7b8f7..0d7378362 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -654,6 +654,16 @@ config DRM_PANEL_NOVATEK_NT35950
 	  Sharp panels used in Sony Xperia Z5 Premium and XZ Premium
 	  mobile phones.
 
+config DRM_PANEL_SAMSUNG_GTA4L
+	tristate "Samsung Galaxy Tab A7 (gta4l) DSI panels"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here to support the 1200x2000 DSI panels fitted to the
+	  Samsung Galaxy Tab A7 (SM-T500/T505). The driver picks the panel
+	  the bootloader names on the kernel command line.
+
 config DRM_PANEL_NOVATEK_NT36523
 	tristate "Novatek NT36523 panel driver"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3b523cf37..15a2b69b3 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -64,6 +64,7 @@ obj-$(CONFIG_DRM_PANEL_NOVATEK_NT35532) += panel-novatek-nt35532.o
