From aaaa5eac7d0057a3ec79f0c7f7363578e662895a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 18:15:23 +0300
Subject: [PATCH 21/24] arm64: dts: qcom: sm6115-samsung-gta4l: scale MBHC
 headset threshold for 2.4V micbias

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index 138868afa..154904a67 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -893,6 +893,13 @@ wcd937x: audio-codec {
 		/* stock: qcom,msm-mbhc-hphl-swh = 1, qcom,msm-mbhc-gnd-swh = 0 */
 		qcom,ground-jack-type-normally-closed;
 
+		/*
+		 * The driver default (1700 mV) is meant for a 1.8 V micbias; with
+		 * the 2.4 V micbias used here a headset mic reads 1.5-1.8 V and
+		 * was misreported as line-out. Scale it: 1700 * 2400 / 1800.
+		 */
+		qcom,mbhc-headset-vthreshold-microvolt = <2200000>;
+
 		qcom,rx-device = <&wcd937x_rx>;
 		qcom,tx-device = <&wcd937x_tx>;
 
