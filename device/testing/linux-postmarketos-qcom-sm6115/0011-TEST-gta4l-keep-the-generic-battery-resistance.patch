From b7419190b31d6d0e3d40f66213bc54319cf71b1f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 17:41:11 +0300
Subject: [PATCH 11/24] TEST: gta4l: keep the generic battery resistance

---
 arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index f59b105a7..2ba880381 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -37,8 +37,7 @@ battery: battery {
 		voltage-min-design-microvolt = <3400000>;
 		voltage-max-design-microvolt = <4400000>;
 		/* Estimate; the stock profile describes it with tables instead */
-		/* Measured on a used unit; a fresh pack is closer to 100 mOhm */
-		factory-internal-resistance-micro-ohms = <240000>;
+		factory-internal-resistance-micro-ohms = <80000>;
 
 		/* Stock "P85943-QRD-SCUD-ATL-4V4-7040mAh" profile at 25 degrees */
 		ocv-capacity-celsius = <25>;
