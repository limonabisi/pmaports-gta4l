From aa07ffa8f4fcbd53fae3da1c67f7e706bd411b96 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 07:55:16 +0300
Subject: [PATCH 07/24] arm64: dts: qcom: gta4l: power the USB port from the
 PMIC boost

Give the Type-C connector its VBUS supply so that USB devices plugged
into the tablet get power. Needs CONFIG_TYPEC_TCPM, CONFIG_TYPEC_QCOM_PMIC
and CONFIG_REGULATOR_QCOM_USB_VBUS. Compile-tested only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016AirPAcjr6JyfsKizshE8B
---
 arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
index 0cd6633cb..f511460af 100644
--- a/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
+++ b/arch/arm64/boot/dts/qcom/sm6115-samsung-gta4l.dts
@@ -215,6 +215,9 @@ connector {
 		typec-power-opmode = "default";
 		pd-disable;
 
+		/* Lets the PMIC boost power USB devices plugged into the tablet */
+		vbus-supply = <&pmi632_vbus>;
+
 		ports {
 			#address-cells = <1>;
 			#size-cells = <0>;
