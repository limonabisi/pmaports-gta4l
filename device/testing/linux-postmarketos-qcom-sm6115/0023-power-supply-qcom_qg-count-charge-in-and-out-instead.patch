 	default:
 		break;
 	}
@@ -412,6 +530,9 @@ static int qcom_qg_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
 		val->intval = qg->ibat_ua;
 		break;
